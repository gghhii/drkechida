@model IEnumerable<DrKchida.Models.VideoItem>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Vidéothèque Admin";
}

<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2.5rem;">
    <div>
        <h1 class="admin-title">Gestion des Vidéos</h1>
        <p class="admin-subtitle">Gérez vos contenus éducatifs et tutoriels pour les patients.</p>
    </div>
    <a href="/Admin/CreateVideo" class="btn-premium">
        <i class="fa-solid fa-plus"></i> Nouvelle Vidéo
    </a>
</div>

<div class="admin-card" style="padding: 0; overflow-x: auto;">
    <table class="admin-table">
        <thead>
            <tr>
                <th style="padding-left: 2rem;">Vidéo</th>
                <th>Catégorie</th>
                <th>Source URL</th>
                <th style="text-align: right; padding-right: 2rem; min-width: 15rem;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="width: 40%; padding-left: 2rem;">
                        <div style="display: flex; align-items: center; gap: 1.5rem;">
                            @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                            {
                                <img src="@item.ThumbnailUrl" style="width: 80px; height: 50px; object-fit: cover; border-radius: 4px; border: 1px solid #eee;" />
                            }
                            else
                            {
                                <div style="width: 80px; height: 50px; background: #f1f5f9; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: #cbd5e1;">
                                    <i class="fa-solid fa-video"></i>
                                </div>
                            }
                            <div>
                                <div style="font-weight: 700; color: #0f172a; font-size: 1rem;">@item.Title</div>
                                <div style="font-size: 0.8rem; color: #64748b; margin-top: 4px; max-width: 250px;">@item.Description</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="status-badge" style="background: #fdf2f8; color: #db2777;">
                            @item.Category
                        </span>
                    </td>
                    <td>
                        <div style="font-size: 0.75rem; color: #0ea5e9; font-family: monospace; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            <i class="fa-solid fa-link" style="margin-right: 5px; opacity: 0.5;"></i> @item.VideoUrl
                        </div>
                    </td>
                    <td style="text-align: right; padding-right: 2rem;">
                        <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
                            <a href="/Admin/EditVideo/@item.Id" class="btn-premium" style="padding: 0.5rem 1rem; font-size: 0.75rem; background: #f1f5f9; color: #0f172a;">
                                <i class="fa-solid fa-pen"></i> Modifier
                            </a>
                            <form action="/Admin/DeleteVideo/@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Supprimer cette vidéo ?')">
                                <button type="submit" class="btn-premium" style="padding: 0.5rem 1rem; font-size: 0.75rem; background: #fee2e2; color: #ef4444;">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
