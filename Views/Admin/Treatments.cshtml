@model IEnumerable<DrKchida.Models.Treatment>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gérer les Soins";
}

<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2.5rem;">
    <div>
        <h1 class="admin-title">Gestion des Soins</h1>
        <p class="admin-subtitle">Consultez et modifiez les traitements disponibles sur le site.</p>
    </div>
    <a href="/Admin/CreateTreatment" class="btn-premium">
        <i class="fa-solid fa-plus"></i> Nouveau Soin
    </a>
</div>

<div class="admin-card" style="padding: 0;">
    <table class="admin-table">
        <thead>
            <tr>
                <th style="padding-left: 2rem;">Soin</th>
                <th>Catégorie</th>
                <th>Aperçu</th>
                <th style="text-align: right; padding-right: 2rem;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="width: 40%; padding-left: 2rem;">
                        <div style="font-weight: 700; color: #0f172a; font-size: 1rem;">@item.Name</div>
                        <div style="font-size: 0.8rem; color: #64748b; margin-top: 4px;">@item.Description?.Substring(0, Math.Min(60, item.Description?.Length ?? 0))...</div>
                    </td>
                    <td>
                        <span class="status-badge" style="background: #f1f5f9; color: #475569;">
                            @(item.ServiceCategory?.Title ?? "N/A")
                        </span>
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name" style="height: 48px; width: 48px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0;" />
                        }
                        else
                        {
                            <div style="height: 48px; width: 48px; border-radius: 8px; background: #f8fafc; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; border: 1px solid #e2e8f0;">
                                @(string.IsNullOrEmpty(item.Icon) ? "✨" : item.Icon)
                            </div>
                        }
                    </td>
                    <td style="text-align: right; padding-right: 2rem;">
                        <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
                            <a href="/Admin/EditTreatment/@item.Id" class="btn-premium" style="padding: 0.5rem 1rem; font-size: 0.75rem; background: #f1f5f9; color: #0f172a;">
                                <i class="fa-solid fa-pen"></i> Modifier
                            </a>
                            <form action="/Admin/DeleteTreatment/@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Supprimer ce soin ?')">
                                <button type="submit" class="btn-premium" style="padding: 0.5rem 1rem; font-size: 0.75rem; background: #fee2e2; color: #ef4444;">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
