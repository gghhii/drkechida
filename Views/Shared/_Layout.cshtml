@using Microsoft.AspNetCore.Http


@{
    var isHomePage = ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home";
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentUICulture.Name;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dr. Kaouthar KECHIDA</title>
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />

    <!-- SEO Meta Tags -->
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Sublimer la Beauté Naturelle avec Confiance & Précision. Médecine Esthétique Personnalisée et Rajeunissement Avancé par le Dr. Kaouthar KECHIDA à Sousse, Tunisie.")" />
    <meta name="keywords" content="Dr Kaouthar Kechida, Médecine Esthétique Sousse, Botox Sousse, Fillers Tunisie, Rajeunissement Peau Sousse, Clinique Cosmétique Sousse" />

    <!-- Open Graph Tags -->
    <meta property="og:title" content="@ViewData["Title"] - Dr. Kaouthar KECHIDA" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Cabinet de Médecine Esthétique à Sousse")" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://www.dr-kechida.com/images/cover.jpeg" />

    <!-- Hreflang Tags -->
    <link rel="alternate" hreflang="fr" href="https://www.dr-kechida.com" />
    <link rel="alternate" hreflang="en" href="https://www.dr-kechida.com/Home/SetLanguage?culture=en" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "MedicalClinic",
      "name": "Dr. Kaouthar KECHIDA",
      "medicalSpecialty": "Aesthetic Medicine",
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "05, Avenue Mahmoud Hochlef",
        "addressLocality": "Sousse",
        "addressCountry": "TN"
      },
      "telephone": "+216 23 322 399",
      "url": "https://www.dr-kechida.com",
      "image": "https://www.dr-kechida.com/images/cover.jpeg"
    }
    </script>

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    
    <link rel="icon" type="image/png" href="~/favicon.png" />

    <style>
        /* MAIN CONTENT SPACING */
        main {
            padding-bottom: 120px; /* Space for sticky bar */
        }

        /* HEADER: TRANSPARENT TO SOLID */
        .main-header {
            height: 100px;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: transparent;
            z-index: 1000;
            display: flex;
            align-items: center;
            transition: all 0.4s var(--transition-smooth);
            border-bottom: 1px solid rgba(255,255,255,0.15);
        }

        .main-header.scrolled, 
        .main-header.header-internal {
            background: rgba(255, 255, 255, 0.95);
            height: 80px;
            backdrop-filter: blur(20px);
            box-shadow: var(--shadow-lg);
            border-bottom: 1px solid var(--c-grey-200);
        }

        .header-flex {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }

        .brand-logo { display: flex; flex-direction: column; }
        
        .dr-name {
            font-family: var(--font-serif);
            font-size: 1.6rem;
            letter-spacing: 1px;
            color: white;
            transition: 0.4s;
            line-height: 1;
        }

        .main-header.scrolled .dr-name,
        .main-header.header-internal .dr-name { 
            background: var(--c-gradient-1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .brand-sub {
            font-family: var(--font-sans);
            font-size: 0.55rem;
            letter-spacing: 2.5px;
            color: rgba(255,255,255,0.8);
            text-transform: uppercase;
            transition: all 0.4s var(--transition-smooth);
            margin-top: 6px;
        }

        .main-header.scrolled .brand-sub,
        .main-header.header-internal .brand-sub { color: var(--c-text-light); }

        .nav-links { display: flex; gap: 1.5rem; align-items: center; }

        
        .nav-item {
            color: white;
            font-family: var(--font-sans);
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            transition: all 0.3s var(--transition-smooth);
            position: relative;
        }

        .nav-item::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--c-gradient-1);
            transition: width 0.3s var(--transition-smooth);
        }

        .nav-item:hover::after {
            width: 100%;
        }

        .main-header.scrolled .nav-item,
        .main-header.header-internal .nav-item { color: var(--c-black); }
        
        .nav-item:hover { 
            background: var(--c-gradient-1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* DROPDOWN STYLES */
        .nav-dropdown { position: relative; display: inline-block; }
        
        /* INVISIBLE BRIDGE: Fixes the gap issue */
        .nav-dropdown::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 40px; /* Covers the 20px gap + buffer */
            top: 100%;
            left: 0;
            background: transparent;
            z-index: 1000;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: white;
            min-width: 200px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            padding: 1rem 0;
            z-index: 1001;
            margin-top: 20px;
            animation: fadeIn 0.2s ease;
        }
        
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .main-header.scrolled .dropdown-content,
        .main-header.header-internal .dropdown-content { margin-top: 10px; }
        .nav-dropdown:hover .dropdown-content { display: block; }

        /* Fix dropdown text color on transparent state */
        .main-header:not(.scrolled):not(.header-internal) .dropdown-content {
            background: rgba(0,0,0,0.8);
        }
        .main-header:not(.scrolled):not(.header-internal) .dropdown-content a {
            color: white;
        }

        .dropdown-content a {
            color: var(--c-black);
            padding: 12px 24px;
            text-decoration: none;
            display: block;
            font-family: var(--font-sans);
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: 0.3s;
        }
        .dropdown-content a:hover { background: var(--c-grey-light); color: var(--c-teal); }

        /* Re-scoping phone and buttons */
        .header-action { display: flex; align-items: center; gap: 2rem; }
        .phone-link { color: white; font-weight: 800; font-size: 0.9rem; }
        
        .main-header.scrolled .phone-link,
        .main-header.header-internal .phone-link { color: var(--c-black); }

        .btn-header {
            padding: 0.75rem 2rem;
            border: 2px solid white;
            color: white;
            text-transform: uppercase;
            font-weight: 700;
            font-size: 0.7rem;
            letter-spacing: 1.5px;
            border-radius: var(--radius-sm);
            transition: all 0.3s var(--transition-smooth);
            position: relative;
            overflow: hidden;
        }

        .btn-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--c-gradient-1);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s var(--transition-smooth);
            z-index: -1;
        }

        .btn-header:hover::before {
            transform: scaleX(1);
        }

        .main-header.scrolled .btn-header,
        .main-header.header-internal .btn-header {
            border-color: var(--c-primary);
            background: var(--c-gradient-1);
            color: white;
        }

        .main-header.scrolled .btn-header:hover,
        .main-header.header-internal .btn-header:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        /* LANGUAGE SWITCHER (FAR RIGHT) */
        .lang-switcher-nav {
            display: flex;
            gap: 0.1rem;
            align-items: center;
            margin-left: 1rem;
            border-left: 1px solid rgba(255,255,255,0.2);
            padding-left: 1rem;
        }

        .main-header.scrolled .lang-switcher-nav,
        .main-header.header-internal .lang-switcher-nav {
            border-left-color: var(--c-grey-200);
        }

        .lang-btn {
            background: transparent;
            border: none;
            color: rgba(255,255,255,0.6);
            font-size: 0.6rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            cursor: pointer;
            padding: 4px 8px;
            transition: all 0.3s;
            line-height: 1;
            text-decoration: none;
        }

        .lang-btn.active {
            color: white !important;
            background: rgba(255,255,255,0.2) !important;
            border-radius: 4px;
        }

        /* Visibility on White/Scrolled Background */
        .main-header.scrolled .lang-btn,
        .main-header.header-internal .lang-btn {
            color: rgba(0,0,0,0.4);
        }

        .main-header.scrolled .lang-btn.active,
        .main-header.header-internal .lang-btn.active {
            color: var(--c-black) !important;
            background: rgba(0,0,0,0.05) !important;
        }

        .lang-btn:hover {
            color: var(--c-teal) !important;
        }
        

        /* ABSOLUTE CLEANUP FOR HEADER – preserve toggle spans */
        .main-header .nav-item::before,
        .main-header .nav-item::after,
        .main-header .btn-header::after,
        .main-header .nav-dropdown::before { 
            display: none !important; 
            content: none !important; 
        }
        /* Restore necessary pseudos */
        .nav-item::after { display: block !important; content: '' !important; }
        .btn-header::before { display: block !important; content: '' !important; }
        .nav-dropdown::after { display: block !important; content: '' !important; }
        
        .lang-btn.active {
            color: white !important;
            background: rgba(255,255,255,0.2) !important;
            border-radius: 4px;
        }
        .main-header.scrolled .lang-btn.active {
            background: rgba(0,0,0,0.05) !important;
        }



        /* HEADER FIXES: ULTIMATE PRECISION */
        .container.header-flex {
            max-width: 95%; /* Use more width for the header */
            gap: 1rem;
        }

        .header-action {
            display: flex;
            align-items: center;
            gap: 1.2rem;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .phone-link {
            white-space: nowrap;
            font-size: 0.8rem !important;
            letter-spacing: 0;
        }

        .btn-header {
            padding: 0.6rem 1.2rem; /* Slightly smaller button */
            font-size: 0.65rem;
        }

        .navbar-toggle { display: none; } /* HIDDEN ON DESKTOP */



        /* MODERN STICKY BAR */
        .miller-sticky-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 70px;
            background: var(--c-black);
            display: flex;
            z-index: 999;
            border-top: 3px solid transparent;
            border-image: var(--c-gradient-1) 1;
            box-shadow: 0 -10px 30px rgba(0,0,0,0.1);
        }

        .sticky-item {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.8rem;
            color: white;
            font-family: var(--font-sans);
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-right: 1px solid rgba(255,255,255,0.1);
            transition: all 0.3s var(--transition-smooth);
            position: relative;
            overflow: hidden;
            padding: 0 5px;
        }

        @@media (max-width: 600px) {
            .miller-sticky-bar { height: 66px; }
            .sticky-text { font-size: 0.62rem; letter-spacing: 0.3px; line-height: 1.25; text-align: center; }
            .sticky-item { gap: 0.25rem; padding: 0 4px; }
            .sticky-item.highlight { flex: 1.4; }
            .sticky-icon i { font-size: 0.95rem !important; }
            main { padding-bottom: 85px; }
        }

        .sticky-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--c-gradient-2);
            opacity: 0;
            transition: opacity 0.3s var(--transition-smooth);
        }

        .sticky-item:hover::before {
            opacity: 0.2;
        }

        .sticky-item.highlight { 
            background: var(--c-gradient-1);
        }
        
        .sticky-item.highlight:hover { 
            transform: scale(1.02);
            box-shadow: inset 0 0 20px rgba(255,255,255,0.2);
        }
        
        .sticky-item:hover:not(.highlight) { 
            color: white;
        }

        .sticky-icon,
        .sticky-text {
            position: relative;
            z-index: 1;
        }

        /* FOOTER */
        .footer-list { list-style: none; padding: 0; margin-top: 1rem; }
        .footer-list li { margin-bottom: 0.7rem; }
        .footer-list a { 
            color: var(--c-grey-400); 
            font-size: 0.9rem; 
            transition: all 0.3s var(--transition-smooth); 
        }
        .footer-list a:hover { 
            background: var(--c-gradient-1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            padding-left: 5px; 
        }

        @@media (max-width: 768px) {
            .footer { text-align: center; }
            .real-social-row { justify-content: center; }
            .footer-bottom { text-align: center; }
            .footer-bottom > div { justify-content: center !important; }
        }
        
        .social-icon {
            width: 40px;
            height: 40px;
            border: 1px solid rgba(255,255,255,0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            font-size: 0.7rem;
            color: white;
            transition: all 0.3s var(--transition-smooth);
        }

        .social-icon:hover { 
            border-color: transparent;
            background: var(--c-gradient-1);
            transform: translateY(-2px);
        }

        .footer-bottom {
            border-top: 1px solid #222;
            margin-top: 4rem;
            padding-top: 2rem;
            font-size: 0.75rem;
            color: #555;
        }

        @@media (max-width: 1200px) {
            .nav-links { gap: 1rem; }
            .nav-item { font-size: 0.65rem; }
            .header-action { gap: 1rem; }
        }

        @@media (max-width: 1150px) {
            .nav-links, .header-action { display: none; }
            
            .nav-links.active {
                display: flex !important;
                flex-direction: column;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100vh;
                background: white;
                justify-content: center;
                align-items: center;
                z-index: 1000;
                gap: 2rem;
                padding: 4rem 2rem;
                overflow-y: auto;
            }

            .nav-links.active .nav-item { 
                font-size: 1.2rem; 
                color: var(--c-black) !important;
            }

            /* HAMBURGER ICON — always visible on mobile */
            .navbar-toggle {
                display: flex !important;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                gap: 5px;
                width: 44px;
                height: 44px;
                background: var(--c-gradient-1);
                border: none;
                border-radius: 50%;
                cursor: pointer;
                z-index: 2000;
                transition: 0.3s;
                position: relative;
                flex-shrink: 0;
                padding: 0;
            }

            .navbar-toggle span {
                display: block !important;
                width: 20px;
                height: 2px;
                background: white !important;
                transition: all 0.3s ease;
                border-radius: 2px;
                margin: 0;
                opacity: 1 !important;
                transform: none;
                position: static;
            }

            /* Toggle active (X) state — driven by JS inline styles in animations.js */

            .lang-switcher-nav {
                margin-left: 0;
                padding-left: 0;
                border-left: none;
                margin-top: 1rem;
            }
            .lang-btn {
                font-size: 1rem;
            }

            .dr-name { font-size: clamp(1rem, 4vw, 1.3rem); }
            .brand-sub { font-size: clamp(0.4rem, 1.5vw, 0.5rem); letter-spacing: 1px; }

            /* Show header action in mobile menu */
            .nav-links.active .header-action-mobile {
                display: flex !important;
                flex-direction: column;
                align-items: center;
                gap: 1.5rem;
                margin-top: 2rem;
                width: 100%;
            }
        }

    </style>
</head>
<body>
    <div class="layout-wrapper">
        <!-- HEADER -->
        <header class="main-header navbar @(isHomePage ? "" : "header-internal")">
            <div class="container header-flex">
                <!-- LOGO -->
                <a asp-controller="Home" asp-action="Index" class="brand-logo">
                    <span class="dr-name">Dr. Kaouthar KECHIDA</span>
                    <span class="brand-sub">MÉDECINE ESTHÉTIQUE & RAJEUNISSEMENT</span>
                </a>

                <nav class="nav-links navbar-menu">
                    <a asp-controller="Home" asp-action="Index" class="nav-item">@Localizer["Home"]</a>
                    <a asp-controller="Home" asp-action="About" class="nav-item">@Localizer["About"]</a>
                    <div class="nav-dropdown">
                        <a href="/soins-esthetiques" class="nav-item dropdown-toggle">@Localizer["Services"]</a>
                        <div class="dropdown-content">
                            <a href="/collection/injectables">Art des Injectables</a>
                            <a href="/collection/biostimulation">Biostimulation</a>
                            <a href="/collection/regenerative">Soins Régénératifs</a>
                            <a href="/collection/technologie">Technologie Avancée</a>
                        </div>
                    </div>
                    <a asp-controller="Home" asp-action="Gallery" class="nav-item">@Localizer["Gallery"]</a>
                    <a asp-controller="Home" asp-action="Videos" class="nav-item">@Localizer["Videos"]</a>
                    <a asp-controller="Home" asp-action="FAQ" class="nav-item">@Localizer["FAQ"]</a>
                    <a asp-controller="Home" asp-action="Contact" class="nav-item">@Localizer["Contact"]</a>

                    <!-- MOBILE-ONLY ACTIONS -->
                    <div class="header-action-mobile" style="display: none;">
                        <a href="tel:+21623322399" class="phone-link" style="color: var(--c-black) !important; font-size: 1.2rem !important; font-weight: 700;">+216 23 322 399</a>
                        <a asp-controller="Home" asp-action="Contact" class="btn-header" style="background: var(--c-gradient-1); border: none; color: white; width: 100%; text-align: center;">@Localizer["BookNow"]</a>
                        <div class="lang-switcher-nav" style="background: var(--c-grey-50); padding: 5px 15px; border-radius: 50px;">
                             <a href="/Home/SetLanguage?culture=fr&returnUrl=@Context.Request.Path" class="lang-btn @(currentCulture.StartsWith("fr") ? "active" : "")" style="color: var(--c-black) !important;">FR</a>
                             <span style="width: 1px; height: 10px; background: rgba(0,0,0,0.1);"></span>
                             <a href="/Home/SetLanguage?culture=en&returnUrl=@Context.Request.Path" class="lang-btn @(currentCulture.StartsWith("en") ? "active" : "")" style="color: var(--c-black) !important;">EN</a>
                        </div>
                    </div>
                </nav>
                <div class="header-action">
                    <a href="tel:+21623322399" class="phone-link">+216 23 322 399</a>
                    <a asp-controller="Home" asp-action="Contact" class="btn-header">@Localizer["BookNow"]</a>
                    
                    <div class="lang-switcher-nav">
                        <a href="/Home/SetLanguage?culture=fr&returnUrl=@Context.Request.Path" class="lang-btn @(currentCulture.StartsWith("fr") ? "active" : "")">FR</a>
                        <span style="width: 1px; height: 10px; background: rgba(128,128,128,0.2);"></span>
                        <a href="/Home/SetLanguage?culture=en&returnUrl=@Context.Request.Path" class="lang-btn @(currentCulture.StartsWith("en") ? "active" : "")">EN</a>
                    </div>
                </div>
                <button class="navbar-toggle" aria-label="Toggle Navigation"><span></span><span></span><span></span></button>
            </div>
        </header>

        <!-- PAGE CONTENT -->
        <main role="main">
            @RenderBody()
        </main>

        <!-- STICKY CTA BAR (MILLER STYLE) -->
        <div class="miller-sticky-bar">
            <a href="/Home/Gallery" class="sticky-item">
                <span class="sticky-icon"><i class="fa-solid fa-images" style="font-size: 1.2rem;"></i></span>
                <span class="sticky-text">Galerie Photos</span>
            </a>
            <a asp-controller="Home" asp-action="Contact" class="sticky-item highlight">
                <span class="sticky-text">Demander Consultation</span>
            </a>
            <button onclick="openWAModal()" class="sticky-item" id="wa-sticky-btn" style="background:none;border:none;cursor:pointer;width:100%;">
                <span class="sticky-icon"><i class="fa-brands fa-whatsapp" style="font-size: 1.2rem;"></i></span>
                <span class="sticky-text">WhatsApp</span>
            </button>
        </div>

        <!-- MAIN FOOTER -->
        <footer class="footer bg-black text-white section">
            <div class="container">
                <div class="grid grid-4">
                    <div>
                        <h4 class="text-white">Emplacement</h4>
                        <p style="color: #888; margin-top: 1rem; line-height: 1.8;">
                            05, Avenue Mahmoud Hochlef<br>
                            (près de la clinique La Corniche)<br>
                            Sousse, Tunisie
                        </p>
                        <p style="color: #888;">+216 23 322 399</p>
                    </div>
                    <div class="footer-col px-4">
                    <h4 class="mb-4">Services</h4>
                    <ul class="footer-list">
                        <li><a href="/collection/face">Soins du Visage</a></li>
                        <li><a href="/collection/body">Soins du Corps</a></li>
                        <li><a href="/collection/hair">Soins des Cheveux</a></li>
                    </ul>
                </div>
                    <div>
                        <h4 class="text-white">Entreprise</h4>
                        <ul class="footer-list">
                            <li><a asp-controller="Home" asp-action="About">À Propos du Dr. Kechida</a></li>
                            <li><a asp-controller="Home" asp-action="Videos">Bibliothèque Vidéo</a></li>
                            <li><a asp-controller="Home" asp-action="FAQ">FAQ Patients</a></li>
