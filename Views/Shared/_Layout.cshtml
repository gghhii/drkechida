    <!-- WA MODAL STYLES -->
    <style>
        /* ── Overlay ── */
        #wa-modal-overlay {
            position: fixed; inset: 0;
            background: rgba(10,10,18,0.75);
            backdrop-filter: blur(8px);
            z-index: 9999;
            display: none; /* Hidden by default */
            align-items: center;
            justify-content: center;
            padding: 1rem;
            animation: waFadeIn 0.25s ease;
        }
        @@keyframes waFadeIn { from{opacity:0} to{opacity:1} }

        /* ── Modal Box ── */
        #wa-modal {
            background: #fff;
            border-radius: 20px;
            width: 100%;
            max-width: 860px;
            max-height: 95vh;
            overflow-y: auto;
            padding: 2.5rem 2rem 2rem;
            position: relative;
            box-shadow: 0 30px 80px rgba(0,0,0,0.3);
            animation: waSlideUp 0.3s cubic-bezier(0.34,1.56,0.64,1);
        }
        @@keyframes waSlideUp { from{opacity:0;transform:translateY(40px)} to{opacity:1;transform:translateY(0)} }

        /* ── Close ── */
        #wa-close-btn {
            position: absolute; top: 1.2rem; right: 1.4rem;
            background: none; border: none;
            font-size: 1.8rem; line-height: 1;
            color: #888; cursor: pointer;
            transition: color 0.2s, transform 0.2s;
            z-index: 2;
        }
        #wa-close-btn:hover { color: #111; transform: rotate(90deg); }

        /* ── Header ── */
        #wa-modal-header {
            display: flex; align-items: flex-start; gap: 1.2rem;
            margin-bottom: 1.5rem;
        }
        #wa-modal-icon {
            width: 52px; height: 52px; min-width: 52px;
            background: linear-gradient(135deg,#25d366,#128c5e);
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.6rem; color: white;
            box-shadow: 0 8px 20px rgba(37,211,102,0.35);
        }
        #wa-modal-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem; color: #1a1a2e; margin: 0 0 0.3rem;
        }
        #wa-modal-sub { font-size: 0.85rem; color: #777; margin: 0; line-height: 1.5; }

        /* ── Gender Toggle ── */
        #wa-gender-toggle {
            display: flex; gap: 0.8rem;
            justify-content: center;
            margin-bottom: 1.5rem;
        }
        .wa-gender-btn {
            padding: 0.6rem 2rem;
            border: 2px solid #e5e7eb;
            background: #f9fafb;
            border-radius: 50px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.85rem; font-weight: 700;
            cursor: pointer;
            transition: all 0.25s;
            color: #555;
        }
        .wa-gender-btn.active {
            background: linear-gradient(135deg,#0ea5e9,#0369a1);
            border-color: transparent;
            color: white;
            box-shadow: 0 4px 14px rgba(14,165,233,0.4);
        }
        .wa-gender-btn:hover:not(.active) { border-color: #0ea5e9; color: #0ea5e9; }

        /* ── Face Layout ── */
        #wa-face-layout {
            display: grid;
            grid-template-columns: 180px 1fr 180px;
            gap: 0.5rem;
            align-items: center;
            min-height: 340px;
        }

        /* ── Labels ── */
        .wa-labels {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .wa-label {
            display: flex;
            align-items: center;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .wa-labels-left .wa-label { flex-direction: row-reverse; justify-content: flex-end; }
        .wa-labels-right .wa-label { flex-direction: row; justify-content: flex-start; }
        .wa-label-text {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.72rem;
            font-weight: 600;
            color: #444;
            white-space: nowrap;
            transition: color 0.2s;
            line-height: 1.3;
        }
        .wa-label.selected .wa-label-text { color: #0ea5e9; }
        .wa-connector {
            flex: 1; min-width: 8px; max-width: 22px;
            height: 1px;
            background: #d1d5db;
            margin: 0 4px;
            transition: background 0.2s;
        }
        .wa-label.selected .wa-connector { background: #0ea5e9; }
        .wa-checkbox {
            width: 16px; height: 16px; min-width: 16px;
            border: 2px solid #d1d5db;
            border-radius: 4px;
            background: white;
            transition: all 0.2s;
            position: relative;
        }
        .wa-label.selected .wa-checkbox {
            background: #0ea5e9;
            border-color: #0ea5e9;
        }
        .wa-label.selected .wa-checkbox::after {
            content: '';
            position: absolute;
            top: 1px; left: 4px;
            width: 5px; height: 9px;
            border: 2px solid white;
            border-top: none; border-left: none;
            transform: rotate(45deg);
        }
        .wa-label:hover .wa-checkbox { border-color: #0ea5e9; }
        .wa-label:hover .wa-label-text { color: #0ea5e9; }

        /* ── Face SVG ── */
        #wa-face-center {
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .wa-face-svg {
            width: 100%;
            max-width: 240px;
            height: auto;
            filter: drop-shadow(0 4px 16px rgba(0,0,0,0.08));
        }
        .wa-hotspot {
            cursor: pointer;
            transition: fill 0.2s;
        }
        .wa-hotspot:hover { fill: rgba(14,165,233,0.15) !important; }
        .wa-hotspot.active { fill: rgba(14,165,233,0.25) !important; }

        /* ── Selected Summary ── */
        #wa-selected-summary {
            margin-top: 1.5rem;
            background: #f0f9ff;
            border: 1px solid #bae6fd;
            border-radius: 12px;
            padding: 1rem 1.2rem;
        }
        #wa-summary-label {
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #0369a1;
            display: block;
            margin-bottom: 0.6rem;
        }
        #wa-tags-container { display: flex; flex-wrap: wrap; gap: 0.4rem; }
        #wa-no-selection { font-size: 0.82rem; color: #aaa; font-style: italic; }
        .wa-tag {
            background: white;
            border: 1.5px solid #0ea5e9;
            color: #0369a1;
            padding: 0.3rem 0.8rem;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 700;
            display: flex; align-items: center; gap: 0.4rem;
            animation: waTagIn 0.2s ease;
        }
        @@keyframes waTagIn { from{opacity:0;transform:scale(0.8)} to{opacity:1;transform:scale(1)} }
        .wa-tag-remove {
            cursor: pointer; color: #0ea5e9;
            font-size: 1rem; line-height: 1;
        }
        .wa-tag-remove:hover { color: #dc2626; }

        /* ── Action Buttons ── */
        #wa-actions {
            display: flex; gap: 1rem;
            justify-content: flex-end;
            margin-top: 1.2rem;
            flex-wrap: wrap;
        }
        #wa-clear-btn {
            padding: 0.7rem 1.5rem;
            border: 2px solid #e5e7eb;
            background: white;
            border-radius: 50px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.8rem; font-weight: 700;
            color: #555; cursor: pointer;
            transition: all 0.2s;
        }
        #wa-clear-btn:hover { border-color: #dc2626; color: #dc2626; }
        #wa-send-btn {
            padding: 0.7rem 2rem;
            background: linear-gradient(135deg,#25d366,#128c5e);
            border: none; border-radius: 50px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.85rem; font-weight: 800;
            color: white; cursor: pointer;
            box-shadow: 0 6px 20px rgba(37,211,102,0.4);
            transition: all 0.25s;
            display: flex; align-items: center; gap: 0.5rem;
        }
        #wa-send-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(37,211,102,0.5); }
        #wa-send-btn:active { transform: translateY(0); }

        /* ── female-only / male-only visibility ── */
        .female-only { display: flex; }
        .male-mode .female-only { display: none !important; }

        /* ── Responsive ── */
        @@media (max-width: 700px) {
            #wa-face-layout {
                grid-template-columns: 1fr;
                grid-template-rows: auto auto auto;
            }
            .wa-labels { flex-direction: row; flex-wrap: wrap; gap: 0.4rem; }
            .wa-labels-left, .wa-labels-right { order: 2; }
            #wa-face-center { order: 1; }
            .wa-label { flex-direction: row !important; justify-content: flex-start !important; }
            .wa-connector { display: none; }
            .wa-face-svg { max-width: 200px; }
            #wa-modal { padding: 2rem 1.2rem 1.5rem; }
        }
    </style>

    <!-- WA MODAL SCRIPT -->
    <script>
        var waSelectedZones = new Set();
        var waCurrentGender = 'female';
        var waPhoneNumber = '21623322399';
        var isWAModalOpen = false;

        function openWAModal() {
            document.getElementById('wa-modal-overlay').style.display = 'flex';
            document.body.style.overflow = 'hidden';
            isWAModalOpen = true;
            // Handle back button closure
            history.pushState({ waModalId: 'open' }, '', '#whatsapp-zones');
        }

        function closeWAModal(fromPopState) {
            document.getElementById('wa-modal-overlay').style.display = 'none';
            document.body.style.overflow = '';
            isWAModalOpen = false;
            // If we're closing NOT via back button, we should remove the hash
            if (!fromPopState && window.location.hash === '#whatsapp-zones') {
                history.back();
            }
        }

        window.onpopstate = function(event) {
            if (isWAModalOpen) {
                closeWAModal(true);
            }
        };

        function closeWAModalOutside(e) {
            if (e.target === document.getElementById('wa-modal-overlay')) closeWAModal();
        }

        function switchGender(gender) {
            waCurrentGender = gender;
            var modal = document.getElementById('wa-modal');
            if (gender === 'male') {
                document.getElementById('face-female').style.display = 'none';
                document.getElementById('face-male').style.display = 'block';
                document.getElementById('btn-female').classList.remove('active');
                document.getElementById('btn-male').classList.add('active');
                modal.classList.add('male-mode');
            } else {
                document.getElementById('face-female').style.display = 'block';
                document.getElementById('face-male').style.display = 'none';
                document.getElementById('btn-male').classList.remove('active');
                document.getElementById('btn-female').classList.add('active');
                modal.classList.remove('male-mode');
            }
            if (gender === 'male') {
                var femaleOnly = ['Tempes', 'Cou', 'Main'];
                femaleOnly.forEach(function(z) { waSelectedZones.delete(z); });
                refreshUI();
            }
        }

        function toggleZone(labelEl) {
            var zone = labelEl.getAttribute('data-zone');
            toggleZoneByName(zone);
        }

        function toggleZoneByName(zone) {
            if (waSelectedZones.has(zone)) {
                waSelectedZones.delete(zone);
            } else {
                waSelectedZones.add(zone);
            }
            refreshUI();
        }

        function refreshUI() {
            document.querySelectorAll('.wa-label').forEach(function(el) {
                var zone = el.getAttribute('data-zone');
                if (waSelectedZones.has(zone)) el.classList.add('selected');
                else el.classList.remove('selected');
            });
            document.querySelectorAll('.wa-hotspot').forEach(function(el) {
                var zone = el.getAttribute('data-zone');
                if (waSelectedZones.has(zone)) el.classList.add('active');
                else el.classList.remove('active');
            });
            var container = document.getElementById('wa-tags-container');
            container.innerHTML = '';
            if (waSelectedZones.size === 0) {
                container.innerHTML = '<span id="wa-no-selection">Aucune zone sélectionnée</span>';
            } else {
                waSelectedZones.forEach(function(zone) {
                    var tag = document.createElement('span');
                    tag.className = 'wa-tag';
                    tag.innerHTML = zone + '<span class="wa-tag-remove" onclick="toggleZoneByName(\'' + zone.replace(/'/g, "\\'") + '\')">&times;</span>';
                    container.appendChild(tag);
                });
            }
        }

        function clearAllZones() {
            waSelectedZones.clear();
            refreshUI();
        }

        function sendToWhatsApp() {
            if (waSelectedZones.size === 0) {
                alert('Veuillez sélectionner au moins une zone à traiter.');
                return;
            }
            
            var zonesList = Array.from(waSelectedZones).join(', ');
            var btn = document.getElementById('wa-send-btn');
            var originalContent = btn.innerHTML;
            
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Envoi...';
            btn.disabled = true;

            fetch('/Home/SubmitWAEnquiry', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'gender=' + encodeURIComponent(waCurrentGender) + '&zones=' + encodeURIComponent(zonesList)
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data.success) {
                    var genderIcon = waCurrentGender === 'female' ? '👩' : '👨';
                    var genderText = waCurrentGender === 'female' ? 'FEMME' : 'HOMME';
                    
                    var emojiMap = {
                        "Front": "💆", "Glabelle": "🤨", "Zone du regard": "👁️", "Tempes": "👤",
                        "Pattes d'oie": "👀", "Pommettes": "😊", "Nez": "👃", "Joues": "👤",
                        "Sillons nasogéniens": "👄", "Contour des lèvres": "👄", "Volume des lèvres": "💄",
                        "Plis d'amertume": "👄", "Angle mandibulaire": "👤", "Menton": "👤",
                        "Ovale du visage": "✨", "Cou": "🦒", "Mains": "🤲"
                    };

                    // Building the message string locally first
                    var msg = '*📍 DR. KECHIDA - CONSULTATION*\n';
                    msg += '*-----------------------------------------*\n\n';
                    msg += '*👤 PROFIL* : ' + genderIcon + ' ' + genderText + '\n';
                    msg += '*📝 RÉF* : #' + data.id + '-WA\n\n';
                    msg += '*-----------------------------------------*\n';
                    msg += '*✨ ZONES D\'INTERÊT* :\n\n';
                    
                    msg += Array.from(waSelectedZones).map(function(z){ 
                        var emoji = emojiMap[z] || "•";
                        return emoji + '  ' + z; 
                    }).join('\n');
                    
                    msg += '\n\n*-----------------------------------------*\n';
                    msg += '_Bonjour Docteur, je souhaite prendre un rendez-vous, merci de le confirmer._';

                    // Final encoding
                    var encodedMsg = encodeURIComponent(msg);
                    window.open('https://wa.me/21623322399?text=' + encodedMsg, '_blank');
                    
                    setTimeout(closeWAModal, 500);
                } else {
                    alert('Erreur : ' + (data.message || 'Inconnue'));
                }
            })
            .catch(function(err) {
                console.error(err);
                alert('Une erreur est survenue.');
            })
            .finally(function() {
                btn.innerHTML = originalContent;
                btn.disabled = false;
            });
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && isWAModalOpen) closeWAModal();
        });
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/animations.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <script>
        // Mobile menu is handled by animations.js → initMobileMenu()
        // No duplicate listener needed here.
    </script>
</body>
</html>
