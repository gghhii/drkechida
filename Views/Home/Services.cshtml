@model IEnumerable<DrKchida.Models.ServiceCategory>
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"];
}


<!-- LUXURY HERO SECTION -->
<section class="hero-bg" style="background-image: url('/images/cover.jpeg'); min-height: 50vh;">
    <div class="hero-bg-overlay" style="background: linear-gradient(to right, rgba(15, 23, 42, 0.9) 0%, rgba(15, 23, 42, 0.4) 100%);"></div>
    <div class="container fade-in">
        <span class="eyebrow" style="color: var(--c-primary-light);">@Localizer["HeroEyebrow"]</span>
        <h1 style="font-size: 5rem; color: white;">@Localizer["HeroTitle"]</h1>
        <div class="accent-line" style="width: 120px; height: 6px; margin-top: 2rem; background: var(--c-primary-light);"></div>
        <p style="max-width: 700px; font-size: 1.4rem; color: rgba(255,255,255,0.9); margin-top: 3rem; line-height: 1.6;">
            @Localizer["HeroDesc"]
        </p>
    </div>

</section>
<!-- MARQUEE TICKER -->
<div class="marquee-container">
    <div class="marquee-content">
        <span class="marquee-item">@Localizer["Marquee1"]</span>
        <span class="marquee-item">•</span>
        <span class="marquee-item">@Localizer["Marquee2"]</span>
        <span class="marquee-item">•</span>
        <span class="marquee-item">@Localizer["Marquee3"]</span>
        <span class="marquee-item">•</span>
        <span class="marquee-item">@Localizer["Marquee4"]</span>
        <span class="marquee-item">•</span>
        <span class="marquee-item">@Localizer["Marquee5"]</span>
        <span class="marquee-item">•</span>
        <span class="marquee-item">@Localizer["Marquee6"]</span>
        <span class="marquee-item">•</span>
        <!-- Duplicated for seamless loop -->
        <span class="marquee-item">@Localizer["Marquee1"]</span>
        <span class="marquee-item">•</span>
        <span class="marquee-item">@Localizer["Marquee2"]</span>
        <span class="marquee-item">•</span>
        <span class="marquee-item">@Localizer["Marquee3"]</span>
        <span class="marquee-item">•</span>
        <span class="marquee-item">@Localizer["Marquee4"]</span>
        <span class="marquee-item">•</span>
        <span class="marquee-item">@Localizer["Marquee5"]</span>
        <span class="marquee-item">•</span>
        <span class="marquee-item">@Localizer["Marquee6"]</span>
    </div>
</div>


<!-- CATEGORIES EXPLORATION -->
<section class="section" style="background-color: var(--c-grey-50); position: relative; overflow: hidden;">
    <!-- Abstract Decoration -->
    <div style="position: absolute; top: 10%; right: -5%; width: 400px; height: 400px; background: rgba(14, 165, 233, 0.03); border-radius: 50%; blur: 100px; z-index: 0;"></div>
    
    <div class="container" style="position: relative; z-index: 1;">
        <div class="grid grid-2" id="services-grid" style="gap: 5rem; align-items: start;">
            @foreach (var category in Model)
            {
                var displayImage = category.ImageUrl;
                if (category.Slug == "injectables") displayImage = "/images/h1.jpeg";
                else if (category.Slug == "biostimulation") displayImage = "/images/h6.png";
                else if (category.Slug == "regenerative") displayImage = "/images/h3.png";
                else if (category.Slug == "technologie") displayImage = "/images/h5.png";

                <div class="luxury-service-card fade-in">
                    <div class="luxury-card-inner">
                        <div class="luxury-image-wrapper">
                            <img src="@displayImage" alt="@Localizer[category.Title ?? ""]" class="luxury-img" />
                            <div class="luxury-badge">@Localizer[category.CardLabel ?? ""]</div>
                            <div class="luxury-overlay">
                                <a href="/collection/@category.Slug" class="luxury-btn">@Localizer["Discover"]</a>
                            </div>

                        </div>
                        
                        <div class="luxury-content">
                            <h2 class="luxury-title">@Localizer[category.Title ?? ""]</h2>
                            <p class="luxury-desc">@Localizer[category.CardDescription ?? ""]</p>
                            
                            <div class="treatment-highlight">
                                <span class="highlight-label">@Localizer["KeyTreatments"]</span>
                                <ul class="luxury-list">
                                    @foreach (var treatment in category.Treatments?.Where(t => t.ShowOnCard) ?? Enumerable.Empty<DrKchida.Models.Treatment>())
                                    {
                                        <li>
                                            <span class="dot"></span>
                                            @Localizer[treatment.Name ?? ""]
                                        </li>
                                    }
                                </ul>
                            </div>
                            
                            <a href="/collection/@category.Slug" class="premium-link">
                                @Localizer["ExploreExpertise"]
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- CLINICAL PHILOSOPHY - THE SIGNATURE EXPERIENCE -->
<section class="section bg-dark-deep text-white" style="padding: 15rem 0; position: relative; overflow: hidden;">
    <!-- Large Background Title for Depth -->
    <div class="text-mega" style="top: 10%; left: 50%; transform: translateX(-50%); color: white;">SIGNATURE</div>

    <div class="container" style="position: relative; z-index: 2;">
        <!-- Header Part -->
        <div style="text-align: center; max-width: 900px; margin: 0 auto 10rem;">
            <span class="eyebrow" style="color: var(--c-primary-light); background: none; -webkit-text-fill-color: initial; display: block; margin-bottom: 2rem;">@Localizer["PhilosophyEyebrow"]</span>
            <h2 style="color: white; font-size: 5rem; line-height: 1; margin-bottom: 3rem; font-family: var(--font-serif); font-style: italic;">@Localizer["PhilosophyQuote"]</h2>
            <div class="accent-line" style="width: 80px; height: 3px; background: var(--c-primary-light); margin: 0 auto;"></div>
        </div>

        <div class="grid grid-2" style="gap: 10rem; align-items: center;">
            <div class="fade-in-left">
                <div style="position: relative;">
                    <!-- Multiple Layered Images -->
                    <div style="position: relative; z-index: 1;">
                        <img src="/images/cab.png" alt="Cabinet" style="width: 100%; height: 600px; object-fit: cover; border-radius: var(--radius-lg); filter: brightness(0.9);" />
                    </div>
                    <div style="position: absolute; top: -30px; left: -30px; width: 100%; height: 100%; border: 1px solid rgba(14, 165, 233, 0.2); border-radius: var(--radius-lg); z-index: 0;"></div>
                    
                    <!-- Floating Stat Card -->
                    <div class="glass-card" style="position: absolute; bottom: 40px; right: -40px; padding: 4rem; width: 350px;">
                        <div style="font-size: 4rem; font-weight: 800; color: var(--c-primary-light); line-height: 1;">10+</div>
                        <p style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 2px; color: white; margin-top: 1rem; opacity: 0.8;">@Html.Raw(Localizer["YearsExperience"].Value)</p>
                    </div>
                </div>
            </div>

            <div class="fade-in-right">
                <div class="grid" style="gap: 4rem;">
                    <!-- Pillar 1 -->
                    <div style="display: flex; gap: 3rem;">
                        <span style="font-size: 1.2rem; font-family: var(--font-serif); color: var(--c-primary-light);">01.</span>
                        <div>
                            <h4 style="color: white; font-family: var(--font-serif); text-transform: none; font-size: 1.8rem; margin-bottom: 1rem;">@Localizer["Pillar1Title"]</h4>
                            <p style="color: rgba(255,255,255,0.6); font-size: 1.1rem; max-width: 100%;">@Localizer["Pillar1Desc"]</p>
                        </div>
                    </div>

                    <!-- Pillar 2 -->
                    <div style="display: flex; gap: 3rem;">
                        <span style="font-size: 1.2rem; font-family: var(--font-serif); color: var(--c-primary-light);">02.</span>
                        <div>
                            <h4 style="color: white; font-family: var(--font-serif); text-transform: none; font-size: 1.8rem; margin-bottom: 1rem;">@Localizer["Pillar2Title"]</h4>
                            <p style="color: rgba(255,255,255,0.6); font-size: 1.1rem; max-width: 100%;">@Localizer["Pillar2Desc"]</p>
                        </div>
                    </div>

                    <!-- Pillar 3 -->
                    <div style="display: flex; gap: 3rem;">
                        <span style="font-size: 1.2rem; font-family: var(--font-serif); color: var(--c-primary-light);">03.</span>
                        <div>
                            <h4 style="color: white; font-family: var(--font-serif); text-transform: none; font-size: 1.8rem; margin-bottom: 1rem;">@Localizer["Pillar3Title"]</h4>
                            <p style="color: rgba(255,255,255,0.6); font-size: 1.1rem; max-width: 100%;">@Localizer["Pillar3Desc"]</p>
                        </div>
                    </div>
                </div>

                <div style="margin-top: 6rem;">
                    <a href="/Home/Contact" class="btn-primary" style="padding: 1.5rem 5rem; background: var(--c-gradient-1); border-radius: 50px;">
                        <span>@Localizer["StartBtn"]</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- THE RITUAL - PROCESS SECTION -->
<section class="section bg-white" style="padding: 12rem 0;">
    <div class="container">
        <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 8rem;">
            <div style="max-width: 600px;">
                <span class="eyebrow" style="color: var(--c-primary);">@Localizer["ProcessEyebrow"]</span>
                <h2 style="font-size: 4rem; margin-top: 2rem;">@Localizer["ProcessTitle"]</h2>
            </div>
            <p style="max-width: 400px; color: var(--c-grey-500); font-size: 1.1rem;">@Localizer["ProcessIntro"]</p>
        </div>

        <div class="grid grid-4" style="gap: 2rem;">
            <div class="process-card fade-in" style="animation-delay: 0.1s;">
                <span style="font-size: 0.7rem; font-weight: 800; color: var(--c-primary); letter-spacing: 2px;">01</span>
                <h4 style="margin: 2rem 0; font-size: 1.4rem; font-family: var(--font-serif); text-transform: none;">@Localizer["Step1Title"]</h4>
                <p style="font-size: 0.95rem; color: var(--c-grey-500); line-height: 1.6;">@Localizer["Step1Desc"]</p>
            </div>

            <div class="process-card fade-in" style="animation-delay: 0.2s;">
                <span style="font-size: 0.7rem; font-weight: 800; color: var(--c-primary); letter-spacing: 2px;">02</span>
                <h4 style="margin: 2rem 0; font-size: 1.4rem; font-family: var(--font-serif); text-transform: none;">@Localizer["Step2Title"]</h4>
                <p style="font-size: 0.95rem; color: var(--c-grey-500); line-height: 1.6;">@Localizer["Step2Desc"]</p>
            </div>

            <div class="process-card fade-in" style="animation-delay: 0.3s;">
                <span style="font-size: 0.7rem; font-weight: 800; color: var(--c-primary); letter-spacing: 2px;">03</span>
                <h4 style="margin: 2rem 0; font-size: 1.4rem; font-family: var(--font-serif); text-transform: none;">@Localizer["Step3Title"]</h4>
                <p style="font-size: 0.95rem; color: var(--c-grey-500); line-height: 1.6;">@Localizer["Step3Desc"]</p>
            </div>

            <div class="process-card fade-in" style="animation-delay: 0.4s;">
                <span style="font-size: 0.7rem; font-weight: 800; color: var(--c-primary); letter-spacing: 2px;">04</span>
                <h4 style="margin: 2rem 0; font-size: 1.4rem; font-family: var(--font-serif); text-transform: none;">@Localizer["Step4Title"]</h4>
                <p style="font-size: 0.95rem; color: var(--c-grey-500); line-height: 1.6;">@Localizer["Step4Desc"]</p>
            </div>
        </div>
    </div>
</section>

<style>
    .luxury-service-card {
        background: transparent;
        transition: transform 0.6s var(--transition-smooth);
    }

    .luxury-card-inner {
        background: white;
        border: 1px solid var(--c-grey-200);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: 0.4s var(--transition-smooth);
        box-shadow: var(--shadow-sm);
    }

    .luxury-service-card:hover .luxury-card-inner {
        transform: translateY(-15px);
        box-shadow: 0 40px 80px rgba(0,0,0,0.08);
        border-color: var(--c-grey-300);
    }

    .luxury-image-wrapper {
        position: relative;
        height: 480px;
        overflow: hidden;
    }

    .luxury-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: 1s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .luxury-service-card:hover .luxury-img {
        transform: scale(1.08);
    }

    .luxury-badge {
        position: absolute;
        bottom: 2rem;
        left: 0;
        background: var(--c-black);
        color: white;
        padding: 0.8rem 2rem;
        font-family: var(--font-sans);
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 3px;
        z-index: 2;
    }

    .luxury-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 23, 42, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: 0.4s;
        z-index: 1;
    }

    .luxury-service-card:hover .luxury-overlay {
        opacity: 1;
    }

    .luxury-btn {
        padding: 1rem 2.5rem;
        background: white;
        color: var(--c-black);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.8rem;
        transform: translateY(20px);
        transition: 0.4s var(--transition-bounce);
    }

    .luxury-service-card:hover .luxury-btn {
        transform: translateY(0);
    }

    .luxury-content {
        padding: 4rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .luxury-title {
        font-size: 2.8rem;
        color: var(--c-black);
        margin-bottom: 1.5rem;
        font-family: var(--font-serif);
    }

    .luxury-desc {
        font-size: 1rem;
        color: var(--c-grey-500);
        margin-bottom: 3rem;
        line-height: 1.8;
    }

    .treatment-highlight {
        background: var(--c-grey-50);
        padding: 2.5rem;
        margin-bottom: 3rem;
        border-radius: 8px;
    }

    .highlight-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-weight: 800;
        color: var(--c-primary);
        display: block;
        margin-bottom: 1.5rem;
    }

    .luxury-list {
        list-style: none;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.2rem;
    }

    .luxury-list li {
        font-family: var(--font-sans);
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--c-black);
        display: flex;
        align-items: center;
        gap: 1.2rem;
    }

    .dot {
        width: 4px;
        height: 4px;
        background: var(--c-primary);
        border-radius: 50%;
    }

    .premium-link {
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        gap: 1rem;
        font-family: var(--font-sans);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-size: 0.85rem;
        color: var(--c-black);
        transition: 0.3s;
    }

    .premium-link svg {
        transition: transform 0.3s var(--transition-smooth);
    }

    .premium-link:hover {
        color: var(--c-primary);
    }

    .premium-link:hover svg {
        transform: translateX(8px);
    }

    .quick-link {
        font-family: var(--font-sans);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.75rem;
        color: var(--c-grey-400);
        position: relative;
        padding: 0.5rem 0;
        transition: 0.3s;
    }

    .quick-link:hover, .quick-link.active {
        color: var(--c-primary);
    }

    .quick-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--c-primary);
        transition: 0.3s;
    }

    .quick-link:hover::after {
        width: 100%;
    }

    @@media (max-width: 1024px) {
        .grid-2 { grid-template-columns: 1fr; }
        .luxury-content { padding: 3rem; }
    }
</style>

@section Scripts {
    <script>
        // Scripts purely for animations or other decorative needs can go here
    </script>
}
